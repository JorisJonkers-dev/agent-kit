{
  "version": 1,
  "clients": {
    "vibe-mistral-large": {
      "kind": "vibe",
      "binary": "vibe",
      "agent": "critic-mistral-large",
      "model": "mistral-large-4-0-3",
      "family": "mistral"
    },
    "agy-gemini-flash-high": {
      "kind": "agy",
      "binary": "agy",
      "model": "gemini-3.8-flash-high",
      "family": "google"
    },
    "vibe-glm": {
      "kind": "vibe",
      "binary": "vibe",
      "agent": "critic-glm",
      "model": "glm-5-3",
      "family": "zhipu"
    },
    "vibe-deepseek-flash": {
      "kind": "vibe",
      "binary": "vibe",
      "agent": "critic-deepseek-flash",
      "model": "deepseek-v4-1-flash-1017",
      "family": "deepseek"
    }
  },
  "budget": { "vibe_flow_cap_usd": 5 },
  "antigravity_quota": {
    "daily_cap": 20,
    "reserve_threshold": 10,
    "reserved_stages": ["spec", "feature-review"]
  },
  "fallbacks": {
    "vibe-mistral-large": ["vibe-glm", "agy-gemini-flash-high"],
    "agy-gemini-flash-high": ["vibe-glm"]
  },
  "stages": {
    "spec": {
      "distinct_families": true,
      "base": [
        {
          "client": "vibe-mistral-large",
          "role": "spec-redteam",
          "lenses": ["fidelity", "testability"],
          "max_price_usd": 0.5,
          "time_limit_s": 600
        },
        {
          "client": "agy-gemini-flash-high",
          "role": "spec-redteam",
          "lenses": ["failure-modes", "security"],
          "max_price_usd": 0.5,
          "time_limit_s": 600
        }
      ],
      "deep": [
        {
          "client": "vibe-glm",
          "role": "spec-redteam",
          "lenses": ["integration", "operability"],
          "max_price_usd": 0.5,
          "time_limit_s": 600
        },
        {
          "client": "vibe-deepseek-flash",
          "role": "spec-redteam",
          "lenses": ["simplicity", "fidelity"],
          "max_price_usd": 0.5,
          "time_limit_s": 600
        }
      ],
      "depth_signals": {
        "thresholds": { "user_stories": 30, "words": 5000 },
        "risk_terms": [
          "auth",
          "authentication",
          "authorisation",
          "authorization",
          "migration",
          "migrations",
          "payment",
          "payments",
          "crypto",
          "cryptography",
          "encryption",
          "concurrency",
          "concurrent",
          "public API"
        ],
        "labels": ["risk:high"]
      }
    },
    "feature-review": {
      "distinct_families": true,
      "base": [
        {
          "client": "vibe-mistral-large",
          "role": "feature-reviewer",
          "lenses": ["integration"],
          "max_price_usd": 1,
          "time_limit_s": 720
        },
        {
          "client": "agy-gemini-flash-high",
          "role": "feature-reviewer",
          "lenses": ["failure-modes"],
          "max_price_usd": 1,
          "time_limit_s": 720
        }
      ],
      "deep": [
        {
          "client": "vibe-glm",
          "role": "feature-reviewer",
          "lenses": ["operability"],
          "max_price_usd": 1,
          "time_limit_s": 720
        },
        {
          "client": "vibe-deepseek-flash",
          "role": "feature-reviewer",
          "lenses": ["simplicity"],
          "max_price_usd": 1,
          "time_limit_s": 720
        }
      ],
      "depth_signals": {
        "labels": ["risk:high"]
      }
    }
  }
}
