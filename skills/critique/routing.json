{
  "version": 1,
  "clients": {
    "vibe-mistral-large": {
      "kind": "vibe",
      "binary": "vibe",
      "agent": "critic-mistral-large",
      "model": "mistral-large-4-0",
      "family": "mistral"
    },
    "agy-gemini-flash-high": {
      "kind": "agy",
      "binary": "agy",
      "model": "gemini-3.8-flash-high",
      "family": "google"
    },
    "vibe-glm": {
      "kind": "vibe",
      "binary": "vibe",
      "agent": "critic-glm",
      "model": "zai-glm-5-3",
      "family": "zhipu"
    },
    "vibe-deepseek-flash": {
      "kind": "vibe",
      "binary": "vibe",
      "agent": "critic-deepseek-flash",
      "model": "deepseek-v4-1-flash-1017",
      "family": "deepseek"
    },
    "vibe-mistral-small": {
      "kind": "vibe",
      "binary": "vibe",
      "agent": "critic-mistral-small",
      "model": "mistral-small-latest",
      "family": "mistral"
    }
  },
  "stats": {
    "min_adjudicated_findings": 20,
    "removal_features": 3
  },
  "budget": { "vibe_flow_cap_usd": 5 },
  "antigravity_quota": {
    "daily_cap": 20,
    "reserve_threshold": 10,
    "reserved_stages": ["spec", "feature-review"]
  },
  "triage": {
    "risk_paths": [
      "**/{auth,authn,authz,oauth,oidc,sso,login,session,sessions,permissions,rbac,acl}/**",
      "**/{auth,authn,authz,oauth,oidc,login,session,sessions,permissions,rbac,acl}.*",
      "**/*{-,_}{auth,oauth,login,session,permission,permissions}.*",
      "**/{crypto,cryptography,encryption,secrets,keys,certs,tls}/**",
      "**/{crypto,encryption,cipher,secrets,jwt,signing,signature,hashing}.*",
      "**/{migrations,migration,migrate}/**",
      "**/*.sql",
      "**/{lock,locks,locking,mutex,semaphore,atomic,atomics,concurrency,threading,scheduler}/**",
      "**/{lock,locks,locking,mutex,semaphore,atomic,atomics,concurrency,threading,scheduler,worker_pool,threadpool}.*",
      "**/*{-,_}{lock,mutex,semaphore}.*",
      "**/api/**",
      "**/*.proto",
      "**/*.graphql",
      "**/{openapi,swagger}*.{json,yaml,yml}",
      "**/{infra,infrastructure,deploy,deployment,deployments,terraform,k8s,kubernetes,helm,charts,ansible}/**",
      "**/*.tf",
      "**/Dockerfile*",
      "**/{docker-compose,compose}*.{yml,yaml}",
      ".github/workflows/**",
      "**/{Jenkinsfile,.gitlab-ci.yml}"
    ],
    "changed_lines_threshold": 300,
    "labels": ["risk:high"],
    "model": { "client": "vibe-mistral-small", "max_price_usd": 0.03, "time_limit_s": 60 }
  },
  "gate": {
    "feature_branches": [
      "feat/**",
      "feature/**",
      "features/**",
      "fix/**",
      "bugfix/**",
      "impl/**",
      "chore/**",
      "docs/**",
      "refactor/**",
      "test/**",
      "perf/**",
      "ci/**",
      "spike/**",
      "wip/**",
      "claude/**",
      "codex/**",
      "worktree-*"
    ]
  },
  "fallbacks": {
    "vibe-mistral-large": ["vibe-glm", "agy-gemini-flash-high"],
    "agy-gemini-flash-high": ["vibe-glm"]
  },
  "stages": {
    "decisions": {
      "distinct_families": true,
      "base": [
        {
          "client": "vibe-mistral-large",
          "role": "gap-critic",
          "lenses": ["unasked-questions"],
          "max_price_usd": 0.3,
          "time_limit_s": 240
        },
        {
          "client": "agy-gemini-flash-high",
          "role": "gap-critic",
          "lenses": ["unasked-questions", "failure-modes"],
          "max_price_usd": 0.3,
          "time_limit_s": 240
        }
      ],
      "deep": [
        {
          "client": "vibe-glm",
          "role": "gap-critic",
          "lenses": ["integration"],
          "max_price_usd": 0.3,
          "time_limit_s": 240
        }
      ],
      "depth_signals": {
        "thresholds": { "decisions": 40, "words": 4000 },
        "risk_terms": [
          "auth",
          "authentication",
          "authorisation",
          "authorization",
          "migration",
          "migrations",
          "payment",
          "payments",
          "crypto",
          "cryptography",
          "encryption",
          "concurrency",
          "concurrent",
          "public API"
        ]
      }
    },
    "spec": {
      "distinct_families": true,
      "base": [
        {
          "client": "vibe-mistral-large",
          "role": "spec-redteam",
          "lenses": ["fidelity", "testability"],
          "max_price_usd": 0.5,
          "time_limit_s": 600
        },
        {
          "client": "agy-gemini-flash-high",
          "role": "spec-redteam",
          "lenses": ["failure-modes", "security"],
          "max_price_usd": 0.5,
          "time_limit_s": 600
        }
      ],
      "deep": [
        {
          "client": "vibe-glm",
          "role": "spec-redteam",
          "lenses": ["integration", "operability"],
          "max_price_usd": 0.5,
          "time_limit_s": 600
        },
        {
          "client": "vibe-deepseek-flash",
          "role": "spec-redteam",
          "lenses": ["simplicity", "fidelity"],
          "max_price_usd": 0.5,
          "time_limit_s": 600
        }
      ],
      "depth_signals": {
        "thresholds": { "user_stories": 30, "words": 5000 },
        "risk_terms": [
          "auth",
          "authentication",
          "authorisation",
          "authorization",
          "migration",
          "migrations",
          "payment",
          "payments",
          "crypto",
          "cryptography",
          "encryption",
          "concurrency",
          "concurrent",
          "public API"
        ],
        "labels": ["risk:high"]
      }
    },
    "tickets": {
      "distinct_families": true,
      "base": [
        {
          "client": "vibe-deepseek-flash",
          "role": "ticket-linter",
          "lenses": ["testability"],
          "max_price_usd": 0.1,
          "time_limit_s": 180
        }
      ],
      "deep": [
        {
          "client": "vibe-mistral-large",
          "role": "ticket-linter",
          "lenses": ["simplicity"],
          "max_price_usd": 0.1,
          "time_limit_s": 180
        }
      ],
      "ticket_size": { "max_modules": 5, "max_criteria": 8 },
      "depth_signals": {
        "thresholds": { "tickets": 10 },
        "risk_terms": [
          "auth",
          "authentication",
          "authorisation",
          "authorization",
          "migration",
          "migrations",
          "payment",
          "payments",
          "crypto",
          "cryptography",
          "encryption",
          "concurrency",
          "concurrent",
          "public API"
        ],
        "labels": ["risk:high"]
      }
    },
    "ticket-review": {
      "distinct_families": true,
      "base": [
        {
          "client": "agy-gemini-flash-high",
          "role": "diff-reviewer",
          "lenses": ["failure-modes", "security"],
          "max_price_usd": 0.5,
          "time_limit_s": 480
        }
      ],
      "deep": [
        {
          "client": "vibe-mistral-large",
          "role": "diff-reviewer",
          "lenses": ["integration"],
          "max_price_usd": 0.5,
          "time_limit_s": 480
        }
      ],
      "depth_signals": {
        "thresholds": { "changed_lines": 600, "risk_path_hits": 3 },
        "labels": ["risk:high"]
      }
    },
    "feature-review": {
      "distinct_families": true,
      "base": [
        {
          "client": "vibe-mistral-large",
          "role": "feature-reviewer",
          "lenses": ["integration"],
          "max_price_usd": 1,
          "time_limit_s": 720
        },
        {
          "client": "agy-gemini-flash-high",
          "role": "feature-reviewer",
          "lenses": ["failure-modes"],
          "max_price_usd": 1,
          "time_limit_s": 720
        }
      ],
      "deep": [
        {
          "client": "vibe-glm",
          "role": "feature-reviewer",
          "lenses": ["operability"],
          "max_price_usd": 1,
          "time_limit_s": 720
        },
        {
          "client": "vibe-deepseek-flash",
          "role": "feature-reviewer",
          "lenses": ["simplicity"],
          "max_price_usd": 1,
          "time_limit_s": 720
        }
      ],
      "depth_signals": {
        "labels": ["risk:high"]
      }
    }
  }
}
