#!/bin/sh
# The critique runner's launcher: `sh <this directory>/critique <command> ...`.
#
# It runs the Rust runner setup built (scripts/install-critique-rust.sh), with
# this directory as its assets. There is no other runner: when the binary is not
# installed the launcher says so and exits 127.
#
# AGENT_KIT_CRITIQUE_BIN names another Rust binary to use.
case $0 in
  */*) here=${0%/*} ;;
  *) here=. ;;
esac
here=$(cd "$here" && pwd) || exit 1
rust=${AGENT_KIT_CRITIQUE_BIN:-${XDG_DATA_HOME:-$HOME/.local/share}/agent-kit/critique/critique}
if [ -f "$rust" ] && [ -x "$rust" ]; then
  AGENT_KIT_CRITIQUE_ASSETS=$here
  export AGENT_KIT_CRITIQUE_ASSETS
  exec "$rust" "$@"
fi
echo "critique: the Rust runner is not installed at $rust; run agent-kit setup with cargo on PATH (scripts/install-critique-rust.sh)" >&2
exit 127
