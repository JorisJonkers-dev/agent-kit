#!/usr/bin/env bash
# managed by agent-kit setup-workstation.sh
#
# model-gateway <subcommand> --json '<object>' | --input <file.json>
#
# The model gateway's command on PATH. It runs the Rust gateway setup built
# (scripts/install-model-gateway-rust.sh). There is no other runner: when the
# binary is not installed it says so and exits 127.
# AGENT_KIT_MODEL_GATEWAY_BIN names another Rust binary to use.
set -euo pipefail
rust="${AGENT_KIT_MODEL_GATEWAY_BIN:-${XDG_DATA_HOME:-${HOME}/.local/share}/agent-kit/model-gateway/model-gateway}"
if [ -f "${rust}" ] && [ -x "${rust}" ]; then
  exec "${rust}" "$@"
fi
echo "model-gateway: the Rust gateway is not installed at ${rust}; run agent-kit setup with cargo on PATH (scripts/install-model-gateway-rust.sh)" >&2
exit 127
