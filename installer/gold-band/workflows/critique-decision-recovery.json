{
  "workflow": {
    "description": "The critique pipeline's stage for the decision recovery (/recover-decisions) as a Gold Band template over the critique runner (issue #458): a run-start node refuses the run when the repository rule or the family allowlist forbids a bound agent, then the runner's prepare, fan-out, refute and record each run as a gate node (the pinned gold-band-gate wrapper around one `critique <command> --strict`, where --strict turns a refusal into a failing exit status) followed by the read-only copier that verifies its report. The runner stays the executor, so the decision recoverers keep its read-only tripwire, packet confinement, time limits and family allowlist; Gold Band only sequences the stages and pauses on the manual check when the orchestrator leaves a finding open. The orchestrator's verdict node sits between fan-out and refute.",
    "version": "0.1",
    "id": "critique-decision-recovery",
    "entry": "gate-critique-decision-recovery-start",
    "control": {
      "max_attempts": 1,
      "max_rounds": 1
    },
    "nodes": [
      {
        "type": "worker",
        "id": "gate-critique-decision-recovery-start",
        "executionSlotId": "slot-gate-critique-decision-recovery-start",
        "provider": "gate-critique-decision-recovery-start",
        "model": "stub-model",
        "profile": "pf-builtin-dev",
        "goal": "Run the pinned gold-band-run-start wrapper for the decision recovery (/recover-decisions), which checks the repository rule and the family allowlist (including its code permission) for every agent id this workflow binds and answer with its exit status as one fenced json block and nothing else.",
        "output": {
          "kind": "json",
          "artifact": "gate-critique-decision-recovery-start-status",
          "schema": {
            "exit_code": 0
          }
        },
        "success_condition": {
