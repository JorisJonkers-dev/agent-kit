        "profile": "pf-builtin-dev",
        "goal": "Run the pinned gold-band-run-start wrapper for to-spec, which checks the repository rule and the family allowlist (including its code permission) for every agent id this workflow binds. Answer with one fenced json block holding its exit status and nothing else.",
        "output": {
          "kind": "json",
          "artifact": "gate-to-spec-start-status",
          "schema": {
            "exit_code": 0
          }
        },
        "success_condition": {
