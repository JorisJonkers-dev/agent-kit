{
  "workflow": {
    "description": "The critique runner's own entry points as a Gold Band template (issue #627, Wave 3): a run-start node refuses the run when the repository rule or the family allowlist forbids a bound agent, then the runner's prepare, fan-out, refute and record each run as a gate node (the pinned gold-band-gate wrapper around one `critique <command> --strict`, where --strict turns a refusal into a failing exit status) followed by the read-only copier that verifies its report. These are the commands the direct lane runs, in the same order, and the template holds no logic of its own: the runner stays the executor, so the critics keep its read-only tripwire, packet confinement, time limits and family allowlist, and Gold Band only sequences the commands and pauses on the manual check when the orchestrator leaves a finding open. The orchestrator's verdict node sits between fan-out and refute. The stage templates (critique-<stage>) are this template bound to one stage's inputs.",
    "version": "0.1",
    "id": "critique",
    "entry": "gate-critique-start",
    "control": {
      "max_attempts": 1,
      "max_rounds": 1
    },
    "nodes": [
      {
        "type": "worker",
        "id": "gate-critique-start",
        "executionSlotId": "slot-gate-critique-start",
        "provider": "gate-critique-start",
        "model": "stub-model",
        "profile": "pf-builtin-dev",
        "goal": "Run the pinned gold-band-run-start wrapper for the critique runner, which checks the repository rule and the family allowlist (including its code permission) for every agent id this workflow binds and answer with its exit status as one fenced json block and nothing else.",
        "output": {
          "kind": "json",
          "artifact": "gate-critique-start-status",
          "schema": {
            "exit_code": 0
          }
        },
        "success_condition": {
          "path": "$.exit_code",
          "equals": 0
        }
      },
      {
        "type": "worker",
        "id": "gate-critique-prepare",
        "executionSlotId": "slot-gate-critique-prepare",
        "provider": "gate-critique-prepare",
        "model": "stub-model",
        "profile": "pf-builtin-dev",
        "goal": "Run the pinned gold-band-gate wrapper around `critique prepare --strict` for the run and answer with its exit status as one fenced json block and nothing else.",
        "output": {
          "kind": "json",
          "artifact": "gate-critique-prepare-status",
          "schema": {
            "exit_code": 0
          }
        },
        "success_condition": {
          "path": "$.exit_code",
          "equals": 0
        }
      },
