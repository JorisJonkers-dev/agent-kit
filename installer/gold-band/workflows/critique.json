        "executionSlotId": "slot-critique-verdicts",
        "provider": "vibe-study",
        "model": "deepseek-v4-1-flash-1017",
        "profile": "pf-builtin-dev",
        "goal": "You are the orchestrator of the critique runner. The runner's fan-out left each critic's findings in its run directory. Check every finding's evidence against the packet, rule on each one, and write the verdicts file beside the runner's files; add nothing the findings do not support. Answer with one fenced json block holding the findings you could not settle on your own and nothing else: an empty list when every finding has a verdict.",
        "output": {
          "kind": "json",
          "artifact": "critique-open-findings",
          "schema": {
            "findings": [
              {
                "id": "string",
                "severity": "string",
                "category": "string",
                "check": "string",
                "location": "string",
                "claim": "string",
                "evidence": [
                  {
                    "kind": "string",
                    "value": "string"
                  }
                ]
              }
            ]
          }
        },
        "success_condition": {
