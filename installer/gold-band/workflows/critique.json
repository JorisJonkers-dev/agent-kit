        "model": "stub-model",
        "profile": "pf-builtin-dev",
        "goal": "Run the pinned gold-band-gate verify copier for the fan-out gate of the critique runner and answer with the report it prints as one fenced json block and nothing else.",
        "output": {
          "kind": "json",
