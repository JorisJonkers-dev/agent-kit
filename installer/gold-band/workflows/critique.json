        "profile": "pf-builtin-dev",
        "goal": "Run the pinned gold-band-gate verify copier for the prepare gate of the critique runner and answer with the report it prints as one fenced json block and nothing else.",
        "output": {
          "kind": "json",
          "artifact": "gate-critique-prepare-report",
          "schema": {
            "run_id": "string",
            "attempt": 1,
            "command": "string",
            "exit_code": 0,
            "output_hash": "string",
            "timestamp": "string"
          }
        },
        "success_condition": {
          "path": "$.exit_code",
          "equals": 0
        }
      },
      {
        "type": "worker",
        "id": "gate-critique-fan-out",
        "executionSlotId": "slot-gate-critique-fan-out",
        "provider": "gate-critique-fan-out",
        "model": "stub-model",
        "profile": "pf-builtin-dev",
