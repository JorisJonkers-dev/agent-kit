#!/usr/bin/env bash
# Refuses commits that credit anyone but the owner. The rule is an allowlist,
# kept as data in allowed-identities next to this file:
#
# - every Co-Authored-By trailer must name an allowed identity: the owner, or
#   a GitHub App bot that is not an AI agent;
# - no message line may match a refuse pattern (a "generated with" or
#   "generated by" line, the robot emoji, an AI provider's address, an agent
#   link);
# - on pre-push, each commit's author and committer must be an allowed
#   identity or a listed non-AI automation; the committer may also be GitHub.
#
# Setup wires this into the global git config as two config hooks
# (hook.<name>.command / hook.<name>.event), so it runs next to each
# repository's own hooks instead of replacing them:
#
#   no-agent-attribution commit-msg <message-file>   checks the new message
#   no-agent-attribution pre-push <remote> <url>     checks every commit the
#                                                    push would publish
set -u
export LC_ALL=C

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
rules_file="${here}/allowed-identities"
local_file="${XDG_CONFIG_HOME:-${HOME}/.config}/agent-kit/allowed-identities.local"

names=() emails=() bots=() agent_bots=() automations=() committers=() refusals=()

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Reads "<kind> <value>" rules. $2 is "all", or "human" for the per-machine
# file, which may only add names and emails.
load_rules() {
  local file="$1" scope="$2" line kind value
  [ -f "${file}" ] || return 0
  while IFS= read -r line || [ -n "${line}" ]; do
    case "${line}" in "" | "#"*) continue ;; esac
    kind="${line%% *}"
    [ "${kind}" = "${line}" ] && continue
    value="$(lower "${line#* }")"
    case "${scope}:${kind}" in
      *:name) names+=("${value}") ;;
      *:email) emails+=("${value}") ;;
      all:bot) bots+=("${value}") ;;
      all:agent-bot) agent_bots+=("${value}") ;;
      all:automation) automations+=("${value}") ;;
      all:committer) committers+=("${value}") ;;
      all:refuse) refusals+=("${value}") ;;
    esac
  done <"${file}"
}

if [ ! -f "${rules_file}" ]; then
  printf 'no-agent-attribution: %s is missing; re-run agent-kit setup\n' "${rules_file}" >&2
  exit 1
fi
load_rules "${rules_file}" all
load_rules "${local_file}" human

# True when $1 is one of the other arguments.
listed() {
  local want="$1" item
  shift
  for item in "$@"; do [ "${item}" = "${want}" ] && return 0; done
  return 1
}

# True when $1 matches one of the extended regexes that follow it.
matches_any() {
  local text="$1" pattern
  shift
  for pattern in "$@"; do
    printf '%s\n' "${text}" | grep -Eq -- "${pattern}" && return 0
  done
  return 1
}

# True when name $1 and email $2, in any case, are an allowed identity: a
# listed name with a listed email, or a GitHub App bot that is not an agent.
allowed_identity() {
  local name email login
  name="$(lower "$1")"
  email="$(lower "$2")"
  if listed "${email}" ${emails[@]+"${emails[@]}"} && listed "${name}" ${names[@]+"${names[@]}"}; then
    return 0
  fi
  matches_any "${email}" ${bots[@]+"${bots[@]}"} || return 1
  login="${email%%@*}"
  login="${login#*+}"
  ! matches_any "${login}" ${agent_bots[@]+"${agent_bots[@]}"} \
    && ! matches_any "${name}" ${agent_bots[@]+"${agent_bots[@]}"}
}

# True when name $1 and email $2 may author or commit: an allowed identity,
# or a listed automation whose email matches no refuse pattern.
allowed_author() {
  allowed_identity "$1" "$2" && return 0
  listed "$(lower "$1")" ${automations[@]+"${automations[@]}"} \
    && ! matches_any "$(lower "$2")" ${refusals[@]+"${refusals[@]}"}
}

# "Name <email>", with the spaces around either part ignored.
trailer_re='^[[:space:]]*([^<]*[^<[:space:]])[[:space:]]*<([^>]+)>[[:space:]]*$'

# Prints each line of the message on stdin that is not allowed. Comment lines
# and everything below git's scissors line are not part of the commit, so
# they are skipped. A credit wrapped across a line break ("Reviewed by" then
# "mistral-large", or "Generated" then "with ...") is caught too: each line is
# also tried joined to the one or two lines before it, within one paragraph,
# and the joined text is printed when only the join matches.
offending_lines() {
  local line lowered name email prev1="" prev2="" joined flagged
  while IFS= read -r line || [ -n "${line}" ]; do
    case "${line}" in
      "# ------------------------ >8 ------------------------"*) break ;;
      "#"*) continue ;;
    esac
    lowered="$(lower "${line}")"
    case "${lowered}" in
      co-authored-by:*)
        name="" email=""
        if [[ "${line#*:}" =~ ${trailer_re} ]]; then
          name="${BASH_REMATCH[1]}"
          email="${BASH_REMATCH[2]}"
        fi
        if ! allowed_identity "${name}" "${email}"; then
          printf '%s\n' "${line}"
          prev2="" prev1=""
          continue
        fi
        ;;
    esac
    flagged=0
    if matches_any "${lowered}" ${refusals[@]+"${refusals[@]}"}; then
      printf '%s\n' "${line}"
      flagged=1
    elif [ -n "${prev1}" ] && printf '%s %s\n' "${prev2}" "${prev1}" | grep -Eiq -- "${credit_words}"; then
      joined="$(unwrap "${prev1} ${line}")"
      if matches_any "$(lower "${joined}")" ${refusals[@]+"${refusals[@]}"}; then
        printf '%s\n' "${joined}"
        flagged=1
      elif [ -n "${prev2}" ]; then
        joined="$(unwrap "${prev2} ${prev1} ${line}")"
        if matches_any "$(lower "${joined}")" ${refusals[@]+"${refusals[@]}"}; then
          printf '%s\n' "${joined}"
          flagged=1
        fi
      fi
    fi
    # A blank line ends the paragraph; a refused line starts a fresh window.
    if [ "${flagged}" = 1 ] || [ -z "${line//[[:space:]]/}" ]; then
      prev2="" prev1=""
    elif [[ "${line}" =~ ^[[:space:]]*([-*+][[:space:]]|[0-9]+[.\)][[:space:]]|#{1,6}[[:space:]]|\||\>) ]]; then
      # A list item, heading, table row or quote starts a new block.
      prev2="" prev1="${line}"
    else
      prev2="${prev1}"
      prev1="${line}"
    fi
  done
}

# The verbs of a credit; a line pair is only joined when it holds one.
credit_words='(generated|written|reviewed|authored|drafted|assisted|created|coded|produced|made|implemented|planned)'

# Collapses every run of whitespace to one space and trims the ends.
unwrap() { printf '%s' "$1" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//'; }

refuse() {
  printf 'no-agent-attribution: %s\n' "$1" >&2
  printf '%s\n' "$2" | sed 's/^/    /' >&2
  printf "no-agent-attribution: commits carry the owner's identity only, never an AI agent's.\n" >&2
  printf 'no-agent-attribution: remove the attribution; the allowed identities are in %s\n' "${rules_file}" >&2
  exit 1
}

check_message() {
  local found
  found="$(offending_lines <"$1")"
  [ -z "${found}" ] || refuse "this commit message credits someone other than the owner:" "${found}"
}

# The problems with one commit, one per line: its message, author, committer.
commit_problems() {
  local sha="$1" an ae cn ce
  git log -1 --format=%B "${sha}" | offending_lines
  an="$(git log -1 --format=%an "${sha}")"
  ae="$(git log -1 --format=%ae "${sha}")"
  cn="$(git log -1 --format=%cn "${sha}")"
  ce="$(git log -1 --format=%ce "${sha}")"
  allowed_author "${an}" "${ae}" || printf 'author: %s <%s>\n' "${an}" "${ae}"
  if ! allowed_author "${cn}" "${ce}" && ! listed "$(lower "${ce}")" ${committers[@]+"${committers[@]}"}; then
    printf 'committer: %s <%s>\n' "${cn}" "${ce}"
  fi
}

check_push() {
  local remote="$1" zero local_sha remote_sha range sha found report=""
  zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
  while read -r _ local_sha _ remote_sha; do
    [ "${local_sha}" = "${zero}" ] && continue
    # A new branch, or a remote tip this clone has never fetched: check what
    # no remote-tracking branch already holds.
    if [ "${remote_sha}" = "${zero}" ] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
      range=("${local_sha}" --not "--remotes=${remote}")
    else
      range=("${remote_sha}..${local_sha}")
    fi
    for sha in $(git rev-list "${range[@]}"); do
      found="$(commit_problems "${sha}")"
      [ -n "${found}" ] && report="${report}$(git log -1 --format='%h %s' "${sha}")"$'\n'"${found}"$'\n'
    done
  done
  [ -z "${report}" ] || refuse "this push would publish commits that credit someone other than the owner:" "${report%$'\n'}"
}

case "${1:-}" in
  commit-msg) check_message "$2" ;;
  pre-push) check_push "$2" ;;
  *) printf 'usage: %s commit-msg <file> | pre-push <remote> <url>\n' "$0" >&2; exit 2 ;;
esac
