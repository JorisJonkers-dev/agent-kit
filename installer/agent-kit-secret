#!/usr/bin/env python3
# managed by agent-kit setup-workstation.sh
"""The one secret store: read, write and check a secret by name.

macOS keeps it in the login Keychain (one generic password per name, service
``agent-kit.<NAME>``). Linux keeps it in the Secret Service (GNOME Keyring or
any libsecret provider), the store Vibe itself uses, through Python's
``keyring`` (service ``agent-kit``, username ``<NAME>``). There is no plain-file
store: a missing backend or a missing key fails closed.

Usage::

    agent-kit-secret get NAME      value on stdout; the only command that prints one
    agent-kit-secret put NAME      value on stdin
    agent-kit-secret delete NAME
    agent-kit-secret has NAME      exit status only; asks the store for the item
                                   without reading its value

Exit status: 0 done, 1 the key is not there, 2 no usable backend or the store
refused. A message goes to stderr; a value never does. Stdlib only, so the
system python3 runs it; on Linux the keyring module comes from
``uv run --with keyring`` (NixOS has neither ``secret-tool`` nor a system
keyring module), and an existence check needs only ``gdbus``.
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys

MAC_PREFIX = "agent-kit."
LINUX_SERVICE = "agent-kit"
INNER = "AGENT_KIT_SECRET_INNER"
NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
TIMEOUT_S = 5
OK, MISSING, UNAVAILABLE = 0, 1, 2


def say(message: str) -> None:
    print(f"agent-kit-secret: {message}", file=sys.stderr)


def backend() -> str:
    forced = os.environ.get("AGENT_KIT_SECRETS_BACKEND", "")
    if forced:
        return forced
    return "keychain" if shutil.which("security") else "libsecret"


def store_name(kind: str) -> str:
    return "keychain" if kind == "keychain" else "Secret Service (libsecret)"


# --- macOS Keychain --------------------------------------------------------


def keychain(command: str, name: str, value: str) -> tuple[int, str]:
    service = MAC_PREFIX + name
    if command == "put":
        # Over stdin, never argv; the value is checked to be shell-safe first.
        if not re.fullmatch(r"[A-Za-z0-9._~+/=-]+", value):
            say("the value has characters the Keychain write cannot carry safely; not stored")
            return UNAVAILABLE, ""
        account = os.environ.get("LOGNAME") or os.environ.get("USER") or "agent-kit"
        script = f'add-generic-password -U -a "{account}" -s "{service}" -w "{value}"\n'
        done = subprocess.run(["security", "-i"], input=script, capture_output=True, text=True, check=False)
        return (OK if done.returncode == 0 else UNAVAILABLE), ""
    if command == "delete":
        done = subprocess.run(["security", "delete-generic-password", "-s", service],
                              capture_output=True, check=False)
        return (OK if done.returncode == 0 else MISSING), ""
    flags = ["-w"] if command == "get" else []
    done = subprocess.run(["security", "find-generic-password", "-s", service, *flags],
                          capture_output=True, text=True, check=False)
    if done.returncode == 44:  # security: "could not be found"
        return MISSING, ""
    if done.returncode != 0:
        return UNAVAILABLE, ""
    return OK, done.stdout.rstrip("\n") if command == "get" else ""


# --- Linux Secret Service --------------------------------------------------


def has_item(name: str) -> int:
    """Ask the Secret Service for the item's path over D-Bus; never a value."""
    if not shutil.which("gdbus"):
        say("gdbus is not installed, so the Secret Service cannot be asked")
        return UNAVAILABLE
    try:
        done = subprocess.run(
            ["gdbus", "call", "--session", "--timeout", str(TIMEOUT_S), "--dest", "org.freedesktop.secrets",
             "--object-path", "/org/freedesktop/secrets", "--method", "org.freedesktop.Secret.Service.SearchItems",
             f"{{'service': '{LINUX_SERVICE}', 'username': '{name}'}}"],
            capture_output=True, text=True, check=False, timeout=TIMEOUT_S + 1,
        )
    except subprocess.TimeoutExpired:
        done = None
    if done is None or done.returncode != 0:
        say("no Secret Service answered on the session bus; unlock or start GNOME Keyring (or another libsecret provider)")
        return UNAVAILABLE
    # Two lists of item paths, unlocked and locked; an item in either exists.
    return OK if re.search(r"'/[^']+'", done.stdout) else MISSING


def keyring_module() -> object | None:
    try:
        import keyring  # noqa: PLC0415 - optional, from uv run --with keyring
    except ImportError:
        return None
    return keyring


def via_uv(value: str) -> int:
    """Run this command again with the keyring module; a value to store goes on its stdin."""
    if os.environ.get(INNER) or not shutil.which("uv"):
        say("the keyring module is not available; install uv, which supplies it, or install python keyring")
        return UNAVAILABLE
    done = subprocess.run(
        ["uv", "run", "--no-project", "--quiet", "--with", "keyring", "python", os.path.abspath(__file__), *sys.argv[1:]],
        env={**os.environ, INNER: "1"}, input=value or None, text=True, check=False,
    )
    return done.returncode


def libsecret(command: str, name: str, value: str) -> tuple[int, str]:
    if command == "has":
        return has_item(name), ""
    keyring = keyring_module()
    if keyring is None:
        sys.exit(via_uv(value))  # the inner run has already said and printed what it should
    try:
        chosen = keyring.get_keyring()  # type: ignore[attr-defined]
        # Only the Secret Service: a file-backed keyring (keyrings.alt) would be a plain-file store.
        if "SecretService" not in f"{type(chosen).__module__}.{type(chosen).__name__}":
            say("keyring found no Secret Service; unlock or start GNOME Keyring (or another libsecret provider)")
            return UNAVAILABLE, ""
        if command == "put":
            keyring.set_password(LINUX_SERVICE, name, value)  # type: ignore[attr-defined]
            return OK, ""
        if command == "delete":
            if keyring.get_password(LINUX_SERVICE, name) is None:  # type: ignore[attr-defined]
                return MISSING, ""
            keyring.delete_password(LINUX_SERVICE, name)  # type: ignore[attr-defined]
            return OK, ""
        found = keyring.get_password(LINUX_SERVICE, name)  # type: ignore[attr-defined]
    except Exception as e:  # the store refused or is locked: say which kind, never what it held
        say(f"the Secret Service refused ({type(e).__name__})")
        return UNAVAILABLE, ""
    return (OK, str(found)) if found else (MISSING, "")


def main(argv: list[str]) -> int:
    if len(argv) != 2 or argv[0] not in ("get", "put", "delete", "has") or not NAME.match(argv[1]):
        say("usage: agent-kit-secret get|put|delete|has NAME")
        return UNAVAILABLE
    command, name = argv
    kind = backend()
    if kind not in ("keychain", "libsecret"):
        say(f"unknown backend {kind!r}; there is no plain-file store")
        return UNAVAILABLE
    value = ""
    if command == "put":
        value = sys.stdin.read().rstrip("\n")
        if not value:
            say("no value on stdin; nothing stored")
            return UNAVAILABLE
    if kind == "keychain" and not shutil.which("security"):
        say("the macOS keychain was asked for, but `security` is not installed")
        return UNAVAILABLE
    status, out = (keychain if kind == "keychain" else libsecret)(command, name, value)
    if status == MISSING and command in ("get", "has"):
        say(f"{name} is not in the {store_name(kind)}; run setup-workstation.sh to store it")
    elif status == UNAVAILABLE:
        say(f"the {store_name(kind)} is not usable; nothing was read or stored")
    if command == "get" and status == OK:
        print(out)
    return status


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
