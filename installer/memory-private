#!/usr/bin/env bash
# managed by agent-kit setup-workstation.sh
#
# memory-private on|off|status [DIR]
# memory-private claude|codex [ARGS...]
#
# Keeps a directory's Claude Code sessions away from the shared Hindsight bank.
# Hindsight Coding Agents goes inert when HINDSIGHT_DISABLED is true, and
# Claude Code passes a project's .claude/settings.local.json `env` block to its
# hooks, so `on` sets that one key there: no shared-bank recall in that
# directory. The file is Claude Code's per-user, git-ignored settings; every
# other key in it is kept. For a single session instead:
# HINDSIGHT_DISABLED=true claude
#
# `claude` and `codex` open one session with the private Hindsight bank (the
# memory-private MCP server, switched off everywhere else), with the shared
# stores Hermes reads (memory-api, hindsight) off, so nothing from
# that session lands where Hermes can see it.
set -euo pipefail

usage() {
  echo "usage: memory-private on|off|status [DIR] | claude|codex [ARGS...]" >&2
  exit 2
}

[ $# -ge 1 ] || usage
cmd="$1"

case "${cmd}" in
  claude | codex)
    shift
    if [ -z "${MEMORY_PRIVATE_TOKEN:-}" ]; then
      # The token sits behind a passphrase; the gate asks for it and runs this again.
      command -v agent-kit-private >/dev/null 2>&1 \
        && exec agent-kit-private exec "$0" "${cmd}" "$@"
      echo "memory-private: MEMORY_PRIVATE_TOKEN is not set and agent-kit-private is not installed; run setup-workstation" >&2
      exit 1
    fi
    # Hindsight Coding Agents' hooks stay inert, so nothing reaches the shared bank.
    export HINDSIGHT_DISABLED=true
    if [ "${cmd}" = claude ]; then
      config="${XDG_CONFIG_HOME:-${HOME}/.config}/agent-kit/memory-private.mcp.json"
      [ -f "${config}" ] || {
        echo "memory-private: ${config} is missing; run setup-workstation.sh" >&2
        exit 1
      }
      # `=` forms: both flags are variadic and would swallow a trailing prompt.
      exec claude --mcp-config="${config}" --disallowedTools=mcp__memory-api,mcp__hindsight "$@"
    fi
    exec codex -c mcp_servers.memory-private.enabled=true -c mcp_servers.memory-api.enabled=false \
      -c mcp_servers.hindsight.enabled=false "$@"
    ;;
esac
dir="${2:-$PWD}"
case "${cmd}" in on | off | status) ;; *) usage ;; esac
[ -d "${dir}" ] || { echo "memory-private: ${dir} is not a directory" >&2; exit 1; }

python3 - "${cmd}" "${dir}" <<'PY'
import json, pathlib, sys

cmd, root = sys.argv[1], pathlib.Path(sys.argv[2]).resolve()
path = root / ".claude" / "settings.local.json"
KEY = "HINDSIGHT_DISABLED"
data = json.loads(path.read_text() or "{}") if path.exists() else {}
env = data.get("env") or {}

if cmd == "status":
    private = str(env.get(KEY, "")).lower() == "true"
    print(f"{root}: {'private (no shared-bank memory)' if private else 'not private (shared-bank memory on)'}")
    raise SystemExit(0)

if cmd == "on":
    env[KEY] = "true"
    data["env"] = env
else:
    env.pop(KEY, None)
    if env:
        data["env"] = env
    else:
        data.pop("env", None)

path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(data, indent=2) + "\n")
back = (json.loads(path.read_text()).get("env") or {}).get(KEY)
if (cmd == "on") != (back == "true"):
    print(f"memory-private: {path} did not take the change", file=sys.stderr)
    raise SystemExit(1)
state = "private: Claude Code sessions here no longer use the shared bank" if cmd == "on" else "shared-bank memory restored"
print(f"{root}: {state}")
PY

# Claude Code git-ignores settings.local.json only when it creates the file
# itself. One created here could otherwise be committed, publishing it.
if [ "${cmd}" = on ] && git -C "${dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  file="${dir}/.claude/settings.local.json"
  if ! git -C "${dir}" check-ignore -q "${file}"; then
    top="$(git -C "${dir}" rev-parse --show-toplevel)"
    rel="$(python3 -c 'import os,sys; print(os.path.relpath(os.path.realpath(sys.argv[1]), os.path.realpath(sys.argv[2])))' "${file}" "${top}")"
    exclude="$(git -C "${dir}" rev-parse --git-path info/exclude)"
    case "${exclude}" in /*) ;; *) exclude="${dir}/${exclude}" ;; esac
    mkdir -p "$(dirname "${exclude}")"
    grep -qxF "/${rel}" "${exclude}" 2>/dev/null || printf '/%s\n' "${rel}" >> "${exclude}"
    git -C "${dir}" check-ignore -q "${file}" \
      || { echo "memory-private: could not git-ignore ${file}" >&2; exit 1; }
    echo "${file}: added to $(basename "$(dirname "${exclude}")")/$(basename "${exclude}") so it is never committed"
  fi
fi
