{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>JorisJonkers-dev/renovate-config"],
  "gitIgnoredAuthors": ["jorisjonkers-dev-agents[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the container tool pins in the tooling registry. Each container: block lists datasource, package and version on consecutive lines.",
      "managerFilePatterns": ["/^registry/estate-tooling\\.yaml$/"],
      "matchStrings": [
        "datasource: (?<datasource>\\S+)\\s+package: \"?(?<depName>[^\"\\s]+)\"?\\s+version: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "description": "Move each plugin marketplace pin that follows a branch to that branch's newest commit, and a skill source of the same upstream with it.",
      "managerFilePatterns": ["/^registry/estate-tooling\\.yaml$/"],
      "matchStrings": [
        "- name: \\S+\\n    repo: (?<depName>[\\w.-]+/[\\w.-]+)\\n    ref: (?<currentValue>main|master)\\n    commit: (?<currentDigest>[a-f0-9]{40})",
        "repo: https://github\\.com/(?<depName>JuliusBrussee/caveman|jgraph/drawio-mcp|LukasNiessen/kubernetes-skill)\\n    ref: (?<currentValue>main|master)\\n    commit: (?<currentDigest>[a-f0-9]{40})"
      ],
      "packageNameTemplate": "https://github.com/{{depName}}",
      "datasourceTemplate": "git-refs",
      "depTypeTemplate": "marketplace-pin"
    },
    {
      "customType": "regex",
      "description": "Move each plugin marketplace pin that follows a tag to the newest tag, and a skill source of the same upstream with it.",
      "managerFilePatterns": ["/^registry/estate-tooling\\.yaml$/"],
      "matchStrings": [
        "- name: \\S+\\n    repo: (?<depName>[\\w.-]+/[\\w.-]+)\\n    ref: (?<currentValue>v?\\d[^\\s]*)\\n    commit: (?<currentDigest>[a-f0-9]{40})",
        "repo: https://github\\.com/(?<depName>JuliusBrussee/caveman|jgraph/drawio-mcp|LukasNiessen/kubernetes-skill)\\n    ref: (?<currentValue>v?\\d[^\\s]*)\\n    commit: (?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-tags",
      "depTypeTemplate": "marketplace-pin"
    },
    {
      "customType": "regex",
      "description": "Update BMAD Method source lock release pins.",
      "managerFilePatterns": ["/^bmad-source\\.lock$/"],
      "matchStrings": [
        "upstream_repository: https://github\\.com/bmad-code-org/BMAD-METHOD(?:\\.git)?\\s+upstream_tag: (?<currentValue>\\S+)(?:\\s+upstream_tag_commit: (?<currentDigest>[a-f0-9]{7,40}))?"
      ],
      "depNameTemplate": "bmad-code-org/BMAD-METHOD",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update spec-compare source lock ref pins.",
      "managerFilePatterns": ["/^spec-compare-source\\.lock$/"],
      "matchStrings": [
        "upstream_repository: (?<packageName>https://github\\.com/cameronsjo/spec-compare(?:\\.git)?)\\s+source_ref: (?<currentValue>\\S+)(?:\\s+resolved_commit_sha: (?<currentDigest>[a-f0-9]{7,40}))?"
      ],
      "depNameTemplate": "cameronsjo/spec-compare",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Update imported skill source lock ref pins.",
      "managerFilePatterns": ["/^skills-source\\.lock$/"],
      "matchStrings": [
        "- upstream_repository: (?<packageName>https://github\\.com/(?<depName>mattpocock/skills|obra/superpowers)(?:\\.git)?)\\s+(?:  [^\\n]+\\s+)*?  source_ref: (?<currentValue>\\S+)(?:\\s+(?:  [^\\n]+\\s+)*?  resolved_commit_sha: (?<currentDigest>[a-f0-9]{7,40}))?"
      ],
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Update the pinned grill-me skill ref (mattpocock/skills) in the skills source lock.",
      "managerFilePatterns": ["/^skills-source\\.lock$/"],
      "matchStrings": [
        "pinned_tag: (?<currentValue>\\S+)\\s+pinned_commit: (?<currentDigest>[a-f0-9]{7,40})"
      ],
      "depNameTemplate": "mattpocock/skills",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the pinned `skills` CLI version used to install grill-me.",
      "managerFilePatterns": ["/^skills-source\\.lock$/"],
      "matchStrings": [
        "skills_cli_version: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "skills",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update Spec Kit source lock release pins.",
      "managerFilePatterns": ["/^spec-kit-source\\.lock$/"],
      "matchStrings": [
        "upstream_repository: https://github\\.com/github/spec-kit(?:\\.git)?\\s+upstream_tag: (?<currentValue>\\S+)(?:\\s+upstream_release_date: \\S+)?(?:\\s+resolved_commit_sha: (?<currentDigest>[a-f0-9]{7,40}))?"
      ],
      "depNameTemplate": "github/spec-kit",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "The image stays on Node 22 LTS.",
      "matchFileNames": ["registry/estate-tooling.yaml"],
      "matchDepNames": ["node"],
      "allowedVersions": "22.x"
    },
    {
      "description": "typescript-language-server needs tsserver, which TypeScript 7 does not ship.",
      "matchFileNames": ["registry/estate-tooling.yaml"],
      "matchDepNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "A marketplace pin bump automerges once every check passes. Marketplace Pin Review fails one that adds a hook, an MCP or LSP server, or a script, which holds it for a person.",
      "matchDepTypes": ["marketplace-pin"],
      "groupName": null,
      "semanticCommitType": "fix",
      "semanticCommitScope": "plugins",
      "addLabels": ["area: tooling"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "prBodyNotes": [
        "Marketplace Pin Review lists what this bump adds that can run code. If it fails, read the upstream change before merging this by hand."
      ]
    },
    {
      "description": "A branch head has no release date, so there is no release age to wait for. Marketplace Pin Review stands in for it.",
      "matchDepTypes": ["marketplace-pin"],
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": null
    },
    {
      "matchFileNames": ["bmad-source.lock"],
      "prBodyNotes": [
        "Run the BMAD source sync command for `bmad-source.lock` before merging so the adapted source stays aligned with this pin."
      ]
    },
    {
      "matchFileNames": ["spec-compare-source.lock"],
      "prBodyNotes": [
        "Run the spec-compare source sync command for `spec-compare-source.lock` before merging so the adapted source stays aligned with this pin."
      ]
    },
    {
      "matchFileNames": ["skills-source.lock"],
      "prBodyNotes": [
        "Run the skills source sync command for `skills-source.lock` before merging so the adapted source stays aligned with this pin."
      ]
    },
    {
      "matchFileNames": ["spec-kit-source.lock"],
      "prBodyNotes": [
        "Run the Spec Kit source sync command for `spec-kit-source.lock` before merging so the adapted source stays aligned with this pin."
      ]
    }
  ]
}
