[
  {
    "env": "HINDSIGHT_API_URL",
    "value": "https://hindsight-api.jorisjonkers.dev",
    "export": true
  },
  {
    "env": "HINDSIGHT_API_TOKEN",
    "grant": "MEMORY_API",
    "check": "https://hindsight-api.jorisjonkers.dev/mcp/default/",
    "export": true
  },
  {
    "env": "MEMORY_MCP_TOKEN",
    "grant": "MEMORY_MCP",
    "check": "https://memory-mcp.jorisjonkers.dev/mcp",
    "export": true
  },
  {
    "env": "MEMORY_PRIVATE_TOKEN",
    "grant": "MEMORY_PRIVATE",
    "check": "https://hindsight-private.jorisjonkers.dev/mcp/private/",
    "export": false,
    "gate": "passphrase"
  },
  {
    "env": "MISTRAL_API_KEY",
    "retired": true
  }
]
