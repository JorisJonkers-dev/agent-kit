{
  "git-host": {
    "type": "stdio",
    "command": "gh-mcp-wrapper"
  },
  "code-intel": {
    "type": "stdio",
    "command": "serena",
    "args": [
      "start-mcp-server",
      "--project-from-cwd",
      "--mode",
      "no-memories",
      "--open-web-dashboard",
      "false"
    ]
  }
}
