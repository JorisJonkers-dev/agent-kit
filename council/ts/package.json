{
  "name": "@jorisjonkers-dev/council",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript council orchestrator package scaffold.",
  "engines": {
    "node": "v26.13.0"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "lint": "eslint .",
    "test": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "dependency-cruiser": "17.4.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
