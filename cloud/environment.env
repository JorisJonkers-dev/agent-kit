# Environment variables for a Claude Code cloud environment. Paste into the
# environment's "Environment variables" field, then fill in the values
# (docs/CLOUD.md). Anyone who can use the environment can read these.

# Memory: Hindsight recall/retain, used by the hindsight-memory plugin hooks
# and the memory-api MCP server. Mint a MEMORY_API service token labelled
# claude-cloud, so it can be revoked without touching another device.
HINDSIGHT_API_URL=https://memory-api.jorisjonkers.dev
HINDSIGHT_API_TOKEN=

# Memory: the Basic Memory vault behind the memory-mcp MCP server. A second
# token, service MEMORY_MCP, same label.
MEMORY_MCP_TOKEN=

# Codex, the council's second engine. Setup logs it in with this key.
OPENAI_API_KEY=

# Hermes, through OpenRouter.
OPENROUTER_API_KEY=

# Overleaf's overleaf.sid cookie. Optional locally, but a cloud VM has no
# stored olcli session, so the overleaf MCP server needs it here.
OVERLEAF_SESSION=

# Room for a Gradle build: 10 minutes by default, 30 at most.
BASH_DEFAULT_TIMEOUT_MS=600000
BASH_MAX_TIMEOUT_MS=1800000
