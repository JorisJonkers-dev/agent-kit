{
  "steps": [
    {
      "argv": [
        "worktrees",
        "clean",
        "--json",
        "{\"all\":true}"
      ],
      "path": [
        "bin"
      ],
      "write": {
        "bin/git": "#!/bin/sh\necho \"$@\" >> \"$HOME/../work/git-calls\"\ncase \"$3 $4\" in\n  \"worktree remove\")\n    case \"$6\" in\n      *failrm*) echo \"fatal: $6 is not a working tree\" >&2; exit 128 ;;\n      *failprune*) echo \"fatal: cannot remove $6\" >&2; exit 128 ;;\n      *failquiet*) exit 1 ;;\n    esac\n    rm -rf \"$6\"\n    exit 0 ;;\n  \"worktree prune\")\n    case \"$*\" in\n      *failprune*) echo \"error: failed to prune worktrees\" >&2; exit 1 ;;\n      *failquiet*) exit 1 ;;\n    esac\n    exit 0 ;;\n  \"branch -D\")\n    case \"$5\" in\n      *failbranchquiet*) exit 1 ;;\n      *failbranch*) echo \"error: the branch $5 is not fully merged\" >&2; exit 1 ;;\n    esac\n    exit 0 ;;\nesac\nexit 0\n",
        "state/agent-kit/model-gateway/kept-worktrees.json": "{\n  \"version\": 1,\n  \"worktrees\": [\n    {\n      \"repo\": \"@SANDBOX@/work/repo-a\",\n      \"path\": \"@SANDBOX@/work/wt-a\",\n      \"branch\": \"gateway/a\",\n      \"run_id\": \"a\",\n      \"workflow\": \"w1\"\n    },\n    {\n      \"path\": \"@SANDBOX@/work/wt-b\",\n      \"branch\": \"gateway/b\",\n      \"run_id\": \"b\",\n      \"workflow\": \"w1\"\n    },\n    {\n      \"repo\": \"@SANDBOX@/work/repo-a\",\n      \"path\": \"@SANDBOX@/work/wt-d\",\n      \"run_id\": \"d\",\n      \"workflow\": \"w1\"\n    },\n    {\n      \"repo\": \"@SANDBOX@/work/repo-a\",\n      \"path\": \"@SANDBOX@/work/wt-e\",\n      \"branch\": \"gateway/e\",\n      \"workflow\": \"w1\"\n    },\n    {\n      \"repo\": \"@SANDBOX@/work/repo-a\",\n      \"path\": \"@SANDBOX@/work/wt-f\",\n      \"branch\": \"gateway/f\",\n      \"run_id\": \"f\"\n    },\n    {\n      \"repo\": 5,\n      \"path\": \"@SANDBOX@/work/wt-g\",\n      \"branch\": \"gateway/g\",\n      \"run_id\": \"g\",\n      \"workflow\": \"w1\"\n    },\n    {\n      \"repo\": \"@SANDBOX@/work/repo-a\",\n      \"path\": \"@SANDBOX@/work/wt-h\",\n      \"branch\": 7,\n      \"run_id\": \"h\",\n      \"workflow\": \"w1\"\n    }\n  ]\n}\n"
      },
      "exec": [
        "bin/git"
      ],
      "mkdir": [
        "work/repo-a",
        "work/wt-a",
        "work/wt-b",
        "work/wt-d",
        "work/wt-e",
        "work/wt-f",
        "work/wt-g",
        "work/wt-h"
      ]
    },
    {
      "argv": [
        "worktrees",
        "clean",
        "--json",
        "{\"workflow\":\"w1\"}"
      ],
      "path": [
        "bin"
      ]
    },
    {
      "argv": [
        "worktrees",
        "clean",
        "--json",
        "{\"all\":true}"
      ],
      "path": [
        "bin"
      ]
    },
    {
      "argv": [
        "worktrees",
        "clean",
        "--json",
        "{\"all\":true}"
      ],
      "path": [
        "bin"
      ]
    }
  ]
}
