      ],
      "write": {
        "state/agent-kit/model-gateway/kept-worktrees.json": "{\n  \"version\": 1,\n  \"worktrees\": [\n    {\n      \"repo\": \"@SANDBOX@/work/repo-a\",\n      \"path\": \"@SANDBOX@/work/wt-ok1\",\n      \"branch\": \"gateway/ok1\",\n      \"run_id\": \"ok1\",\n      \"workflow\": \"w1\"\n    },\n    {\n      \"repo\": \"@SANDBOX@/work/repo-a\",\n      \"path\": \"@SANDBOX@/work/wt-ok3\",\n      \"branch\": \"gateway/ok3\",\n      \"run_id\": \"ok3\",\n      \"workflow\": \"w2\"\n    }\n  ]\n}\n"
      },
      "mkdir": [
        "work/wt-ok1",
        "work/wt-ok3"
      ]
    },
    {
      "argv": [
