        "bin/vibe": "#!/bin/sh\necho \"Available: glm-5-3, deepseek-v4-1-flash-1017\" >&2\n",
        "bin/opencode": "#!/bin/sh\necho \"garbage\"\n"
      },
      "exec": [
        "bin/hermes",
        "bin/vibe",
        "bin/opencode"
      ],
      "env": {
        "XDG_CACHE_HOME": "@SANDBOX@/cache"
      }
    },
    {
      "argv": [
        "models",
        "--json",
        "{}"
      ],
      "path": [
        "bin"
      ],
      "write": {
        "bin/hermes": "#!/bin/sh\necho \"not json\"\n"
      },
      "exec": [
        "bin/hermes"
      ],
      "env": {
        "XDG_CACHE_HOME": "@SANDBOX@/cache"
      }
    },
    {
      "argv": [
        "models",
        "--json",
        "{}"
      ],
      "path": [
        "bin"
      ],
      "write": {
        "bin/hermes": "#!/bin/sh\necho \"[1]\"\n"
      },
      "exec": [
        "bin/hermes"
      ],
      "env": {
        "XDG_CACHE_HOME": "@SANDBOX@/cache"
      }
    },
    {
      "argv": [
        "models",
        "--json",
        "{}"
      ],
      "path": [
        "bin"
      ],
      "write": {
        "bin/hermes": "#!/bin/sh\nexit 4\n"
      },
      "exec": [
        "bin/hermes"
      ],
      "env": {
        "XDG_CACHE_HOME": "@SANDBOX@/cache"
      }
