        "bin/git": "#!/bin/sh\necho \"$@\" >> \"$HOME/../work/git-calls\"\ncase \"$3 $4\" in\n  \"worktree remove\")\n    case \"$6\" in\n      *failrm*) echo \"fatal: $6 is not a working tree\" >&2; exit 128 ;;\n      *failprune*) echo \"fatal: cannot remove $6\" >&2; exit 128 ;;\n      *failquiet*) exit 1 ;;\n    esac\n    rm -rf \"$6\"\n    exit 0 ;;\n  \"worktree prune\")\n    case \"$*\" in\n      *failprune*) echo \"error: failed to prune worktrees\" >&2; exit 1 ;;\n      *failquiet*) exit 1 ;;\n    esac\n    exit 0 ;;\n  \"branch -D\")\n    case \"$5\" in\n      *failbranchquiet*) exit 1 ;;\n      *failbranch*) echo \"error: the branch $5 is not fully merged\" >&2; exit 1 ;;\n    esac\n    exit 0 ;;\nesac\nexit 0\n",
        "state/agent-kit/model-gateway/kept-worktrees.json": "{\n  \"version\": 1,\n  \"worktrees\": [\n    {\n      \"repo\": \"@SANDBOX@/work/repo-a\",\n      \"path\": \"@SANDBOX@/work/wt-a\",\n      \"branch\": \"gateway/a\",\n      \"run_id\": \"a\",\n      \"workflow\": \"w1\",\n      \"at\": \"2026-11-03T10:00:00.000Z\",\n      \"note\": \"kept for the owner\"\n    },\n    {\n      \"repo\": \"@SANDBOX@/work/repo-b\",\n      \"path\": \"@SANDBOX@/work/wt-b\",\n      \"branch\": \"gateway/b\",\n      \"run_id\": \"b\",\n      \"workflow\": \"w2\"\n    },\n    {\n      \"repo\": \"@SANDBOX@/work/repo-a\",\n      \"path\": \"@SANDBOX@/work/wt-c\",\n      \"branch\": \"gateway/c\",\n      \"run_id\": \"c\",\n      \"workflow\": \"w1\",\n      \"at\": \"2026-11-03T10:05:00.000Z\"\n    },\n    {\n      \"repo\": \"@SANDBOX@/work/repo-c\",\n      \"path\": \"@SANDBOX@/work/wt-d\",\n      \"branch\": \"gateway/d\",\n      \"run_id\": \"d\",\n      \"workflow\": \"w3\",\n      \"extra\": {\n        \"nested\": true\n      }\n    }\n  ]\n}\n"
      },
