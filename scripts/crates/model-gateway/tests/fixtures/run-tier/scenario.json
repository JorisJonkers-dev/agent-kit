      "write": {
        "bin/pi": "#!/bin/sh\nD=\"$HOME/calls\"\nC=\"$HOME/canned\"\nmkdir -p \"$D\"\ncase \"$1\" in\n  login|auth) echo \"status $*\" >> \"$D/pi.txt\"; echo \"signed in with an api key\"; exit 0 ;;\nesac\nn=0\n[ -f \"$D/pi.n\" ] && read n < \"$D/pi.n\"\nn=$((n + 1))\necho \"$n\" > \"$D/pi.n\"\npick() { if [ -f \"$C/pi.$1.$n\" ]; then echo \"$C/pi.$1.$n\"; else echo \"$C/pi.$1\"; fi; }\n{\n  echo \"call $n\"\n  echo \"cwd $(pwd -P)\"\n  for a in \"$@\"; do echo \"arg $a\"; done\n  echo \"env AGENT_KIT_DELEGATION=${AGENT_KIT_DELEGATION-<unset>}\"\n  echo \"env MISTRAL_API_KEY=${MISTRAL_API_KEY-<unset>}\"\n  echo \"env VIBE_HOME=${VIBE_HOME-<unset>}\"\n  echo \"env VIBE_ENABLE_MCP=${VIBE_ENABLE_MCP-<unset>}\"\n  echo \"env VIBE_ENABLE_SUBAGENTS=${VIBE_ENABLE_SUBAGENTS-<unset>}\"\n  echo \"env VIBE_INCLUDE_PROJECT_CONTEXT=${VIBE_INCLUDE_PROJECT_CONTEXT-<unset>}\"\n  echo \"env VIBE_OUTSIDE_WORKDIR=${VIBE_OUTSIDE_WORKDIR-<unset>}\"\n  echo \"env VIBE_MCP_SERVERS=${VIBE_MCP_SERVERS-<unset>}\"\n} >> \"$D/pi.txt\"\n\nprev=\nfor a in \"$@\"; do\n  case \"$prev\" in\n    --output-dir) outdir=$a ;;\n    --usage-file) usage=$a ;;\n  esac\n  prev=$a\ndone\nf=$(pick act)\n[ -f \"$f\" ] && . \"$f\"\nf=$(pick export)\nif [ -n \"$outdir\" ] && [ -f \"$f\" ]; then mkdir -p \"$outdir\"; cat \"$f\" > \"$outdir/export.json\"; fi\nf=$(pick usage)\nif [ -n \"$usage\" ] && [ -f \"$f\" ]; then cat \"$f\" > \"$usage\"; fi\nf=$(pick sleep)\n[ -f \"$f\" ] && exec sleep 30\nf=$(pick out)\n[ -f \"$f\" ] && cat \"$f\"\nf=$(pick err)\n[ -f \"$f\" ] && cat \"$f\" >&2\nex=0\nf=$(pick exit)\n[ -f \"$f\" ] && read ex < \"$f\"\nexit \"$ex\"\n",
        "bin/agent-launcher": "#!/bin/sh\nD=\"$HOME/calls\"\nmkdir -p \"$D\"\n{\n  echo \"launcher $*\" | sed -E 's/--net-connect [0-9]+/--net-connect PORT/'\n  echo \"env PATH=$PATH\"\n  echo \"env PI_CODING_AGENT_DIR=${PI_CODING_AGENT_DIR-<unset>}\"\n  echo \"env TMPDIR=${TMPDIR-<unset>}\"\n  echo \"agent settings.json: $(cat \"$PI_CODING_AGENT_DIR/settings.json\")\"\n  echo \"agent models.json: $(sed -E 's/127[.]0[.]0[.]1:[0-9]+/127.0.0.1:PORT/; s/\"apiKey\": \"[0-9a-f]+\"/\"apiKey\": \"TOKEN\"/' \"$PI_CODING_AGENT_DIR/models.json\")\"\n} >> \"$D/launcher.txt\"\nwhile [ \"$1\" != \"--\" ]; do shift; done\nshift\nexec \"$@\"\n",
        "bin/agent-kit-secret": "#!/bin/sh\ncase \"$2\" in\n  MISSING) echo \"no such secret\" >&2; exit 1 ;;\n  *) echo \"secret-for-$2\" ;;\nesac\n",
        "home/.pi/agent/models.json": "{\"providers\":{\"litellm-free\":{\"api\":\"openai-completions\",\"apiKey\":\"literal-key\",\"baseUrl\":\"https://litellm.example/v1\",\"models\":[{\"id\":\"tier-free\",\"cost\":{\"input\":0,\"output\":0,\"cacheRead\":0,\"cacheWrite\":0}}]}}}",
        "home/canned/pi.out": "{\"type\":\"tool_execution_start\",\"toolName\":\"read\",\"args\":{\"path\":\"README.md\"}}\n{\"type\":\"message_end\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"ignored\"}]}}\n{\"type\":\"message_end\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Looked.\\nSUMMARY: pi is fine\"}],\"stopReason\":\"stop\",\"usage\":{\"input\":100,\"output\":40,\"cacheRead\":30,\"cost\":{\"total\":0.002}}}}\n"
      }
    },
