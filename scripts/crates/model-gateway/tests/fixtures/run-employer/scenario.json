        [
          "-C",
          "@SANDBOX@/repo",
          "remote",
          "add",
          "origin",
          "https://github.com/JorisJonkers-dev/demo.git"
        ],
        [
          "-C",
          "@SANDBOX@/repo",
          "add",
          "-A"
        ],
        [
          "-C",
          "@SANDBOX@/repo",
          "commit",
          "-q",
          "-m",
          "init"
        ]
      ],
      "remove": [
        "home/canned/codex.out",
        "home/canned/codex.err",
        "home/canned/codex.exit",
        "home/canned/codex.export",
        "home/canned/codex.usage",
        "home/canned/codex.sleep",
        "home/canned/codex.act"
      ],
      "env": {
        "XDG_CACHE_HOME": "@SANDBOX@/cache",
        "TMPDIR": "@SANDBOX@/tmp"
      },
      "roots": [
        "tmp",
        "repo/.git/model-gateway"
      ]
