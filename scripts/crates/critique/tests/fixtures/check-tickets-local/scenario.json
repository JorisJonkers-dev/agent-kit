{
  "steps": [
    {
      "argv": [
        "--help"
      ],
      "write": {
        "repos/l1/docs/agents/issue-tracker.md": "# Issue tracker: Local Markdown\n\nTickets live in .scratch.\n",
        "repos/l1/.scratch/feat/spec.md": "# Feature\n\n## User stories\n\n1. one\n2. two\n3. three\n",
        "repos/l1/.scratch/feat/issues/01-schema.md": "# 01: Schema\n\nStatus: done\n\nBlocked by: None (can start immediately)\n\n## Acceptance criteria\n\n- [ ] a\n- [x] b\n\nUser story 1\n",
        "repos/l1/.scratch/feat/issues/02-api.md": "# 02 - API\n\n**Blocked by:** 01, 03\n\n- [ ] c\n\nuser stories 2–3\n",
        "repos/l1/.scratch/feat/issues/03-ui.md": "# UI\n\n## Blocked by\n\n- #2\n- Schema\n- Missing ticket\n",
        "repos/l1/.scratch/feat/issues/notes.txt": "not a ticket\n",
        "repos/l1/.scratch/feat/issues/sub/04-x.md": "# nested, not read\n",
        "repos/l1/spec.md": "# Root spec\n\nNo stories.\n",
        "repos/l1/issues/1-a.md": "# A\n\nBlocked by: 1\n",
        "repos/l1/other/spec.md": "# Other\n",
        "repos/l2/docs/agents/issue-tracker.md": "# Issue tracker: Local Markdown\n\nTickets live in .scratch.\n",
        "repos/l2/x.md": "# x\n"
      },
      "git": [
        [
          "init",
          "-q",
          "--template=",
          "repos/l1"
        ],
        [
          "-C",
          "repos/l1",
          "remote",
          "add",
          "origin",
          "git@github.com:JorisJonkers-dev/example.git"
        ],
        [
          "-C",
          "repos/l1",
          "add",
          "-A"
        ],
        [
          "-C",
          "repos/l1",
          "commit",
          "-q",
          "-m",
          "base"
        ],
        [
          "init",
          "-q",
          "--template=",
          "repos/l2"
        ],
        [
          "-C",
          "repos/l2",
          "remote",
          "add",
          "origin",
          "https://gitlab.com/someone/project.git"
        ],
        [
          "-C",
          "repos/l2",
          "add",
          "-A"
        ],
        [
          "-C",
          "repos/l2",
          "commit",
          "-q",
          "-m",
          "base"
        ]
      ]
    },
    {
      "argv": [
        "check-tickets",
        "--json",
        "{\"repo\":\"@SANDBOX@/repos/l1\",\"spec\":\".scratch/feat/spec.md\"}"
      ],
      "path": [
        "bin"
      ],
      "write": {
        "bin/gh": "#!/bin/sh\nif [ \"$1\" = api ]; then\ncase \"$6\" in\n\nesac\nelif [ \"$1 $2\" = \"issue view\" ]; then\ncase \"$3\" in\n\nesac\nfi\necho \"gh: unexpected: $*\" >&2\nexit 9\n"
      },
      "exec": [
        "bin/gh"
      ],
      "shims": [
        "env",
        "git"
      ]
    },
    {
      "argv": [
        "check-tickets",
        "--json",
        "{\"repo\":\"@SANDBOX@/repos/l1\",\"spec\":\"@SANDBOX@/repos/l1/.scratch/feat/spec.md\"}"
      ],
      "path": [
        "bin"
      ]
    },
    {
      "argv": [
        "check-tickets",
        "--json",
        "{\"repo\":\"@SANDBOX@/repos/l1\",\"spec\":\"spec.md\"}"
      ],
      "path": [
        "bin"
      ]
    },
    {
      "argv": [
        "check-tickets",
        "--json",
        "{\"repo\":\"@SANDBOX@/repos/l1\",\"spec\":\"other/spec.md\"}"
      ],
      "path": [
        "bin"
      ]
    },
    {
      "argv": [
        "check-tickets",
        "--json",
        "{\"repo\":\"@SANDBOX@/repos/l1\",\"spec\":\"missing.md\"}"
      ],
      "path": [
        "bin"
      ]
    },
    {
      "argv": [
        "check-tickets",
        "--json",
        "{\"repo\":\"@SANDBOX@/repos/l1\",\"spec\":\"../outside.md\"}"
      ],
      "path": [
        "bin"
      ]
    },
    {
      "argv": [
        "check-tickets",
        "--json",
        "{\"repo\":\"@SANDBOX@/repos/l2\",\"spec\":\"x.md\"}"
      ],
      "path": [
        "bin"
      ]
    }
  ]
}
