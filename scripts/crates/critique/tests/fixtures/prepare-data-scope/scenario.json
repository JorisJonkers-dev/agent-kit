      ],
      "path": [
        "bin"
      ],
      "write": {
        "home/.config/agent-kit/critique-allowlist.json": "{\"repositories\":{\"github.com/jorisjonkers-dev/example\":{\"code\":true,\"families\":[\"mistral\",\"zhipu\"],\"history\":false,\"updated_at\":\"2026-11-01T00:00:00.000Z\"}},\"version\":1}\n",
        "bin/vibe": "#!/bin/sh\nexit 0\n",
        "home/.vibe/.env": "MISTRAL_API_KEY=sk-test\nZAI_API_KEY=sk-z\n",
        "home/.vibe/agents/critic-mistral-large.toml": "# agent\n",
        "home/.vibe/agents/critic-glm.toml": "# agent\n",
        "home/.vibe/agents/critic-mistral-small.toml": "# agent\n",
        "home/.config/agent-kit/critique-routing.json": "{\"clients\":{\"pi-public-glm\":{\"binary\":\"pi\",\"data_scope\":\"public\",\"family\":\"zhipu\",\"kind\":\"pi\",\"model\":\"glm-5-3\",\"provider\":\"litellm-vibe-study\"}},\"fallbacks\":{\"pi-public-glm\":[\"vibe-glm\"]},\"stages\":{\"spec\":{\"base\":[{\"client\":\"pi-public-glm\",\"role\":\"spec-redteam\",\"lenses\":[\"fidelity\"],\"max_price_usd\":0.5,\"time_limit_s\":600}],\"deep\":[]}}}\n"
      },
      "exec": [
        "bin/vibe"
      ],
      "roots": [
        "repos/k1/.git/critique"
      ]
    },
    {
