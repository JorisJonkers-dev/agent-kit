 }
 
+function reachesOverSuccessEdges(edges: WorkflowDsl['edges'], from: string, to: string): boolean {
+  const seen = new Set<string>([from]);
+  const stack = [from];
+  while (stack.length > 0) {
+    const current = stack.pop()!;
+    if (current === to) return true;
+    edges.forEach((edge) => {
+      if (edge.on === 'success' && edge.from === current && !seen.has(edge.to)) {
+        seen.add(edge.to);
+        stack.push(edge.to);
+      }
+    });
+  }
+  return false;
+}
+
 export function deriveWorkflowEntryCandidateIds(workflow: Pick<WorkflowDsl, 'nodes' | 'edges'>): string[] {
   const nodeIds = new Set(workflow.nodes.map((node) => node.id).filter(Boolean));
   const nodeOrder = workflowSuccessTopologyOrder({ ...workflow, entry: '' });
   const incomingNodeIds = new Set<string>();
   workflow.edges.forEach((edge) => {
     if (!nodeIds.has(edge.from) || !nodeIds.has(edge.to)) return;
-    if (edge.on !== 'success' && isBackwardEdge(edge.from, edge.to, nodeOrder)) return;
+    // A backward non-success edge is a retry loop and is ignored, but only when it really closes
+    // a loop: its target reaches its source over success edges. A failure edge to a node that
+    // merely sorts earlier (a human check reached only by failure) still makes that node a non-entry.
+    if (edge.on !== 'success' && isBackwardEdge(edge.from, edge.to, nodeOrder) && reachesOverSuccessEdges(workflow.edges, edge.to, edge.from)) return;
     incomingNodeIds.add(edge.to);
   });
   return workflow.nodes
