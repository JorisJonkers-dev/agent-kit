+import { describe, expect, it } from 'vitest';
+import { deriveWorkflowEntryCandidateIds } from '../src/components/WorkflowEditor';
+import type { WorkflowDsl } from '../src/types';
+
+function node(id: string) {
+  return { type: 'worker' as const, id, executionSlotId: `slot-${id}`, profile: 'developer', goal: id };
+}
+
+function entries(ids: string[], edges: WorkflowDsl['edges']) {
+  return deriveWorkflowEntryCandidateIds({ nodes: ids.map(node), edges });
+}
+
+describe('workflow entry candidates and failure targets', () => {
+  it('does not treat a node reached only by a failure edge as an entry, whatever its position', () => {
+    expect(entries(['check', 'gate', 'round'], [
+      { from: 'gate', to: 'round', on: 'success' },
+      { from: 'round', to: '$end', on: 'success' },
+      { from: 'round', to: 'check', on: 'failure' },
+      { from: 'check', to: '$end', on: 'success' },
+    ])).toEqual(['gate']);
+  });
+
+  it('still ignores a failure edge that closes a success loop back to the entry', () => {
+    expect(entries(['dev', 'test'], [
+      { from: 'dev', to: 'test', on: 'success' },
+      { from: 'test', to: 'dev', on: 'failure' },
+      { from: 'test', to: '$end', on: 'success' },
+    ])).toEqual(['dev']);
+  });
+
+  it('still counts a node with no incoming edge at all as an entry, and none is none', () => {
+    expect(entries(['a', 'b'], [
+      { from: 'a', to: '$end', on: 'success' },
+      { from: 'b', to: '$end', on: 'success' },
+    ])).toEqual(['a', 'b']);
+    expect(entries(['a', 'b'], [
+      { from: 'a', to: 'b', on: 'success' },
+      { from: 'b', to: 'a', on: 'success' },
+    ])).toEqual([]);
+  });
+});
